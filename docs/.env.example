# Copy to .env and tune. Prefix for all settings: MLXSERVE_

# Si un autre service (ex. Docker web) utilise déjà 8080 sur la machine :
# MLXSERVE_PORT=8088

# Warm-up: load default model at server start (dedicated mini / prod UX)
# MLXSERVE_PRELOAD_DEFAULT_MODEL=true

# Default recommandé (voir aussi scripts/install_launchagent_macos.sh)
# MLXSERVE_DEFAULT_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit

# --- Example: 32B-class on ~16 GiB unified memory (validated bench, code-oriented model) ---
# MLXSERVE_DEFAULT_MODEL=mlx-community/Qwen2.5-Coder-32B-Instruct-3bit
# MLXSERVE_PREFILL_STEP_SIZE=512
# MLXSERVE_KV_BITS=4
# MLXSERVE_QUANTIZED_KV_START=32
